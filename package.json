{
  "name": "manual-subscription",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "db:reset": "bun prisma/reset.ts && bun prisma/seed.ts",
