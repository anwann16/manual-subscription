// Subscription & Manual Payment SaaS — schema derived from docs/ERD.md
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  WAITING_VERIFICATION
  ACTIVE
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DurationUnit {
  DAY
  MONTH
  YEAR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions    Subscription[]
  verifiedPayments Payment[]      @relation("PaymentVerifiedBy")
}

model SubscriptionPlan {
  id           String       @id @default(cuid())
  name         String
  description  String
  price        Decimal      @db.Decimal(12, 2)
  duration     Int
  durationUnit DurationUnit
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  planId String

  status SubscriptionStatus @default(PENDING_PAYMENT)
  // startDate/endDate are null until a payment is approved (PRD §13).
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([planId])
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  // Object key inside the Neon Object Storage bucket; the bucket is private, so
  // the URL served to clients is the authenticated `/api/payments/:id/proof`.
  proofKey       String
  submittedAt    DateTime      @default(now())
  verifiedAt     DateTime?
  verifiedById   String?
  rejectionReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  verifiedBy   User?        @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  // Enforces the "at most one active PENDING payment per subscription" lookup path
  // (partial unique index is not expressible in PSL — enforced in application layer).
  @@index([subscriptionId, status])
  @@index([status, submittedAt])
  @@index([verifiedById])
}
